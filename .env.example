# Public build settings only. These values are readable in the APK; never add secrets.
# Default preserves current development behavior and does not expose an API.
EXPO_PUBLIC_APP_MODE=local

# For an explicitly approved external Devnet test build:
# EXPO_PUBLIC_APP_MODE=server-preview
# EXPO_PUBLIC_API_URL=https://<approved-api-domain>
# EXPO_PUBLIC_IDENTITY_ORIGIN=https://<approved-website-domain>
